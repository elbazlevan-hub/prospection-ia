     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// remplit leadId tout seul : le meilleur prospect débloqué qui a un message AIDY",
         "const leads = pm.response.json();",
         "if (Array.isArray(leads) && leads.length) {",
         "  const open = leads.filter(l => !l.locked);",
         "  const best = open.find(l => l.message && l.status === 'toContact') || open.find(l => l.message) || open[0] || leads[0];",
         "  pm.collectionVariables.set('leadId', best._id);",
         "  console.log('leadId =', best._id, '-', best.businessId ? best.businessId.name : '(verrouillé)');",
         "  console.log('verrouillés :', leads.filter(l => l.locked).length, '/ débloqués :', open.length);",
         "}"
        ]
       }
      }
     ]
    },
