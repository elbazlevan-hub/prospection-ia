# copie ce fichier en .env et remplis les valeurs (le .env ne va JAMAIS sur GitHub)
PORT=3000
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prospection
JWT_SECRET=change-moi-par-une-longue-phrase-secrete
CLIENT_URL=http://localhost:5173
NODE_ENV=development
GOOGLE_PLACES_API_KEY=AIza...ta-cle-google...
ANTHROPIC_API_KEY=sk-ant-...ta-cle-claude...
ANTHROPIC_MODEL=claude-haiku-5-5
# anti-abus : nombre d'essais gratuits par connexion internet sur 30 jours
FREE_TRIALS_PER_IP=2
